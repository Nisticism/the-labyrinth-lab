# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on
PORT=4000

# Long random string used to sign JWT tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=b3c37071858a5cf75ded1db4d35f0804fef53208e159c0da61862afa0ac3b9f8407af8bf344bddae85a65c72a92b19f6

# bcrypt hash of your admin password. Generate with:
#   npm run setup:password
ADMIN_PASSWORD_HASH=

# Secret URL path for the admin portal (no leading slash).
# Pick something unguessable; treat like a secret.
# Must also be set as REACT_APP_ADMIN_PATH below (used by the frontend at build time).
ADMIN_PATH=admin-portal-change-me
REACT_APP_ADMIN_PATH=admin-portal-change-me

# Optional: the public URL of your deployed API. Leave blank in production
# (same-origin requests). Set during development if frontend dev server is on a
# different port than the API.
REACT_APP_API_BASE=

# Optional: if your gallery JSON/uploads are stored outside the Git repo, point
# the deploy script at that directory so the ignored data files are synced before
# each deploy. Set one or more of the following.
GALLERY_SYNC_SOURCE=
GALLERY_SYNC_DATA_DIR=
GALLERY_SYNC_IMAGES_DIR=

# Public site name used by nginx and displayed in deployment output.
SITE_DOMAIN=the-ll.com

# Contact form delivery settings. If SMTP is configured, the server sends mail
# through that provider; otherwise it falls back to FormSubmit.
CONTACT_EMAIL=labyrinthlabs0@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
